natscommish.com, www.natscommish.com {
	root * /srv/nats-commish
	encode zstd gzip

	# League server: polls, Trade Wire, Leaderboard, ESPN rankings and player cards.
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
